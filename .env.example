# Server & App
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Storage & Limits
TEMP_DIR=/tmp/clipshort
MAX_VIDEO_DURATION=43200
MAX_CLIP_DURATION=60
MIN_CLIP_DURATION=1
JOB_TIMEOUT_MS=300000
CONCURRENCY=2
RETENTION_MS=1800000
MIN_FREE_DISK_MB=500

# Queue / Redis (optional; falls back to in-memory queue when unset or unreachable)
REDIS_URL=

# Binaries & YouTube Cookies (optional server-side Netscape cookies file)
YTDLP_PATH=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_COOKIES_FILE=
AUTO_UPDATE_YTDLP=false

# Rate Limiting
RATE_LIMIT_INFO_PER_MIN=10
RATE_LIMIT_CLIPS_PER_HOUR=5

# Security & Compliance
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ALLOW_ONLY_CC_OR_OWN=false
DMCA_CONTACT_EMAIL=dmca@clipshort.example
